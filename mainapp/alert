import pyautogui
from PIL import Image
import numpy as np

def count_red_pixels(image, threshold=200):
    # Convert image to numpy array
    img_array = np.array(image)
    
    # Define a mask for red pixels
    red_mask = (img_array[:, :, 0] > threshold) & (img_array[:, :, 1] < threshold) & (img_array[:, :, 2] < threshold)
    
    # Count red pixels
    red_pixel_count = np.sum(red_mask)
    return red_pixel_count

def main(x1, y1, x2, y2, click_x, click_y, percent_threshold):
    # Take a screenshot
    screenshot = pyautogui.screenshot()

    # Crop the screenshot to the specified range
    cropped_image = screenshot.crop((x1, y1, x2, y2))

    # Count total pixels in the cropped image
    total_pixels = cropped_image.size[0] * cropped_image.size[1]

    # Count red pixels
    red_pixel_count = count_red_pixels(cropped_image)

    # Calculate the percentage of red pixels
    red_percentage = (red_pixel_count / total_pixels) * 100

    print(f"Red pixel percentage: {red_percentage:.2f}%")

    # Check if the percentage of red pixels exceeds the threshold
    if red_percentage > percent_threshold:
        print(f"Clicking at ({click_x}, {click_y})")
        pyautogui.click(click_x, click_y)

# Example usage
if __name__ == "__main__":
    # Define the coordinates and threshold
    x1, y1 = 100, 100  # Top-left corner of the area to check
    x2, y2 = 400, 400  # Bottom-right corner of the area to check
    click_x, click_y = 200, 200  # Coordinates to click if condition is met
    percent_threshold = 5.0  # Percentage threshold for red pixels

    main(x1, y1, x2, y2, click_x, click_y, percent_threshold)